# ==============================================================================
# ZEROGATE SYSTEM CONFIGS
# ==============================================================================
ZEROGATE_MOCK=True
SIM_TOTAL_REQUESTS=10
SIM_BATCH_SIZE=5
BURST_THRESHOLD=15
SCALE_TO_ZERO_TIMEOUT=10
SCALE_TO_ZERO_WARN_WINDOW=5
ZEROGATE_API_KEY=zerogate-alpha-demo
ZEROGATE_BASE_URL=your_zerogate_endpoint

# ==============================================================================
# LOCAL SERVICE CONFIGS
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=zerogate-kafka:29092
KAFKA_TOPIC=inference_requests
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://zerogate_admin:zerogate_password@postgres:5432/zerogate_telemetry
POSTGRES_USER=zerogate_admin
POSTGRES_PASSWORD=zerogate_password
POSTGRES_DB=zerogate_telemetry

# ==============================================================================
# HYPERSTACK CONFIGS
# ==============================================================================
HYPERSTACK_BASE_URL=https://infrahub-api.nexgencloud.com/v1
HYPERSTACK_API_KEY=your_hyperstack_api_key_here
HYPERSTACK_MAIN_NODE_IP=your_prewarmed_hyperstack_node_ip
HYPERSTACK_SSH_KEY_NAME=your_ssh_key_name
HYPERSTACK_ENVIRONMENT_NAME=your_environment_name
HYPERSTACK_REGION=your_region_name
